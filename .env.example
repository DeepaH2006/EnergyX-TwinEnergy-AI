# GEMINI_API_KEY: Optional for AI-assisted natural language explanations of backend results.
# Never send raw uploaded datasets without user consent; only aggregated summaries are explained.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Leave empty to use Vite's same-origin proxy (/api/v1 -> FastAPI backend),
# or set explicitly (e.g. http://127.0.0.1:8000) when running FastAPI separately on a different origin.
VITE_API_BASE_URL=""
